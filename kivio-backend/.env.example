# Database
# devcontainer: DB_URL is overridden to jdbc:postgresql://db:5432/kivio in docker-compose.yml
# DB_URL=jdbc:postgresql://localhost:5432/kivio
DB_URL=jdbc:postgresql://db:5432/kivio
DB_USERNAME=kivio
DB_PASSWORD=password

# Redis (TTL storage for registration OTP / registration session — ADR-006)
# devcontainer: overridden to REDIS_HOST=redis in docker-compose.yml
# Production also needs REDIS_PASSWORD and REDIS_SSL=true (see docs/infra/DEPLOYMENT.md §5-1)
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail (Mailpit for local dev, Resend for production)
# devcontainer: overridden to mailpit:1025 in docker-compose.yml
MAIL_HOST=localhost
MAIL_PORT=1025
# Sender identity — shared by SmtpEmailSender (dev) and ResendEmailSender (prod)
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Kivio

# JWT
# JWT_SECRET は必須。未設定だとアプリが起動しません。
# 生成コマンド例: openssl rand -base64 32
JWT_SECRET=your-32-byte-or-longer-random-secret-here
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Google OAuth
# Google OAuth を使用しない場合でも、これらの値は必須です。ダミー値を設定してください。
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy

# Stripe (test mode only)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (prod only — dev sends through Mailpit)
# prod プロファイルでは未設定だと起動に失敗します（設定漏れの早期検知）
RESEND_API_KEY=re_

# App
ALLOWED_ORIGINS=http://localhost:3000
PROBLEM_BASE_URL=https://kivio.example.com
SPRING_PROFILES_ACTIVE=dev
